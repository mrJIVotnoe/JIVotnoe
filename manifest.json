
{
  "manifest_version": 3,
  "name": "ByeDPI Mate",
  "version": "1.8.0",
  "description": "Конфигуратор и управление прокси для ByeDPI",
  "action": {
    "default_popup": "index.html",
    "default_title": "ByeDPI Mate",
    "default_icon": "icon.png"
  },
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://silent-base-fce1.newjiv.workers.dev/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
